---
/** Platform Reference domain landing pages: /api/reference/<slug> (src/data/api/layout.json). */
import DomainPage from '../../../components/api/DomainPage.astro';
import { apiProduct, domainsFor } from '../../../lib/api-docs/data';

export function getStaticPaths() {
  return domainsFor(apiProduct('platform')!).map((d) => ({ params: { domain: d.slug }, props: { slug: d.slug } }));
}
const { slug } = Astro.props;
---
<DomainPage product="platform" slug={slug} />
