---
/**
 * Replaces Starlight's "Auto ▾" theme dropdown with a clear one-click
 * sun/moon toggle. Persists to the same `starlight-theme` localStorage key
 * Starlight's ThemeProvider reads on load, so the choice sticks across
 * navigations and sessions.
 */
---

<sb-theme-toggle>
  <button type="button" aria-live="polite" title="Toggle light/dark theme">
    <svg
      class="sun"
      aria-hidden="true"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <circle cx="12" cy="12" r="4"></circle>
      <path
        d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
      ></path>
    </svg>
    <svg
      class="moon"
      aria-hidden="true"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
    </svg>
    <span class="sr-only">Toggle light/dark theme</span>
  </button>
</sb-theme-toggle>

<style>
  button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--sl-color-hairline, var(--sb-border));
    border-radius: 999px;
    background: transparent;
    color: var(--sl-color-gray-2);
    cursor: pointer;
    transition:
      background-color 0.15s ease,
      color 0.15s ease;
  }
  button:hover {
    background: var(--sl-color-gray-6, rgba(128, 128, 128, 0.12));
    color: var(--sl-color-white);
  }
  /* Show the icon for the theme you'd switch TO */
  :global([data-theme='light']) .sun {
    display: none;
  }
  :global([data-theme='dark']) .moon {
    display: none;
  }
</style>

<script>
  class SbThemeToggle extends HTMLElement {
    constructor() {
      super();
      const button = this.querySelector('button');
      button?.addEventListener('click', () => {
        const current =
          document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
        const next = current === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem('starlight-theme', next);
        } catch {}
      });
    }
  }
  customElements.define('sb-theme-toggle', SbThemeToggle);
</script>
