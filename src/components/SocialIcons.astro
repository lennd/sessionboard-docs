---
/**
 * Top-bar actions, left of the theme toggle: "Get updates" (opens the
 * release-notes-by-email dialog, ReleaseNotesUpdatesDialog.astro — mounted
 * once from Footer.astro, because Starlight renders this component twice:
 * header and mobile menu), "Contact support", then Starlight's social icons.
 */
import Default from '@astrojs/starlight/components/SocialIcons.astro';
---

<button class="sb-updates-link" type="button" data-sb-updates-open aria-haspopup="dialog" aria-controls="sb-updates-dialog">
  <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"></path>
    <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"></path>
  </svg>
  Get updates
</button>
<a class="support-link" href="/faq/who-can-i-contact-for-additional-assistance">Contact support</a>
<Default><slot /></Default>

<style>
  .sb-updates-link,
  .support-link {
    font: inherit;
    font-size: var(--sl-text-sm);
    font-weight: 600;
    color: var(--sl-color-gray-2);
    text-decoration: none;
    white-space: nowrap;
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 999px;
    background: transparent;
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s;
  }
  .sb-updates-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .sb-updates-link:hover,
  .support-link:hover {
    color: var(--sl-color-white);
    border-color: var(--sl-color-gray-4);
  }
  .sb-updates-link:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }
  /* The header has no room for them on small screens; the mobile menu does. */
  @media (max-width: 50rem) {
    .sb-updates-link,
    .support-link {
      display: none;
    }
    :global(.mobile-preferences) .sb-updates-link {
      display: inline-flex;
    }
    :global(.mobile-preferences) .support-link {
      display: inline-block;
    }
  }
</style>
