---
/**
 * Footer override: default Starlight footer plus a growth-style demo CTA band.
 * UTM parameters mirror growth-pages demo_url() so HubSpot/GA4 attribution
 * reports docs-driven demos alongside growth-page demos.
 */
import Default from '@astrojs/starlight/components/Footer.astro';

const { id } = Astro.locals.starlightRoute;
const slug = id === 'index' ? 'home' : id.replace(/\//g, '-');
const demoHref =
  'https://www.sessionboard.com/contact' +
  `?utm_source=help-center&utm_medium=docs&utm_campaign=${encodeURIComponent(slug)}` +
  `&utm_content=footer-cta&sb_growth_page=${encodeURIComponent(slug)}&sb_growth_type=docs`;
---

<Default><slot /></Default>

<aside class="sb-footer-cta" aria-label="Get started with Sessionboard" data-pagefind-ignore>
  <div>
    <p class="sb-footer-cta-title">New to Sessionboard?</p>
    <p class="sb-footer-cta-sub">See how teams run speakers, sessions, and content in one place.</p>
  </div>
  <a class="sb-footer-cta-btn" href={demoHref}>Request a demo</a>
</aside>

<style>
  .sb-footer-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 2rem;
    padding: 1.25rem 1.5rem;
    border-radius: 20px;
    background: linear-gradient(100deg, #efedff 7%, #e2ecff 99%);
    border: 1px solid var(--sb-border);
  }
  :global([data-theme='dark']) .sb-footer-cta {
    background: linear-gradient(100deg, #1c2447 7%, #16224a 99%);
    border-color: transparent;
  }
  .sb-footer-cta p {
    margin: 0;
  }
  .sb-footer-cta-title {
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--sl-color-white);
  }
  .sb-footer-cta-sub {
    font-size: var(--sl-text-sm);
    color: var(--sb-muted);
  }
  .sb-footer-cta-btn {
    background: #3e75e2;
    border: 1px solid #6591e8;
    color: #fff;
    font-weight: 600;
    font-size: var(--sl-text-sm);
    padding: 0.625rem 1.5rem;
    border-radius: 8px;
    text-decoration: none;
    white-space: nowrap;
    box-shadow: 0 8px 20px -8px rgba(30, 98, 216, 0.55);
  }
  .sb-footer-cta-btn:hover {
    background: #1854c4;
  }
</style>
