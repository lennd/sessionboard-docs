---
/**
 * Override of Starlight's Sidebar: identical, except it renders our
 * SidebarSublist copy (which tags group <li>s with data-group for the
 * separators in custom.css), under the signed-in reader's "For you" guides
 * (ForYou.astro, hidden until src/scripts/account.mjs reveals it).
 */
import MobileMenuFooter from 'virtual:starlight/components/MobileMenuFooter';
import SidebarPersister from '@astrojs/starlight/components/SidebarPersister.astro';
import SidebarSublist from './SidebarSublist.astro';
import ForYou from './ForYou.astro';

const { sidebar } = Astro.locals.starlightRoute;
---

<SidebarPersister>
	<ForYou />
	<SidebarSublist sublist={sidebar} />
</SidebarPersister>

<div class="md:sl-hidden">
	<MobileMenuFooter />
</div>
