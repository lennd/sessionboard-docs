---
/**
 * Callout for features that require enablement (paid add-ons or
 * support-enabled features): Speaker CRM, Awards, SSO, Insights,
 * Program Site, Custom Email Domain, etc.
 */
import { Aside } from '@astrojs/starlight/components';

interface Props {
  feature?: string;
}
const { feature } = Astro.props;
---

<Aside type="note" title="Add-on feature">
  {feature ? `${feature} requires` : 'This feature requires'} enablement for your
  organization. Contact <a href="mailto:support@sessionboard.com">support@sessionboard.com</a>
  to get started.<slot />
</Aside>
