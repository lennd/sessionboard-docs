---
/**
 * Field-type badge matching the in-app field editor: the same lucide icon and
 * accent color web-ui-v2 uses for each custom field type (EditFieldSidebar's
 * getFieldIcon / getFieldTypeColor). Inline SVG so the docs site needs no icon
 * dependency; colors follow the app's light/dark pairs.
 *
 * Usage: <FieldTypeIcon type="tree" /> — optionally label={false} to render
 * the icon square alone.
 */
interface Props {
  type: string;
  label?: boolean;
}

const { type, label = true } = Astro.props;

// Lucide 24x24 stroke paths, keyed by the app's field type ids.
const ICON_PATHS: Record<string, string> = {
  text: '<polyline points="4 7 4 4 20 4 20 7"/><line x1="9" x2="15" y1="20" y2="20"/><line x1="12" x2="12" y1="4" y2="20"/>',
  textarea:
    '<line x1="21" x2="3" y1="6" y2="6"/><line x1="15" x2="3" y1="12" y2="12"/><line x1="17" x2="3" y1="18" y2="18"/>',
  email:
    '<rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>',
  phone:
    '<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>',
  number:
    '<line x1="4" x2="20" y1="9" y2="9"/><line x1="4" x2="20" y1="15" y2="15"/><line x1="10" x2="8" y1="3" y2="21"/><line x1="16" x2="14" y1="3" y2="21"/>',
  date: '<path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/>',
  datetime:
    '<path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/>',
  time: '<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>',
  file: '<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/>',
  dropdown:
    '<line x1="8" x2="21" y1="6" y2="6"/><line x1="8" x2="21" y1="12" y2="12"/><line x1="8" x2="21" y1="18" y2="18"/><line x1="3" x2="3.01" y1="6" y2="6"/><line x1="3" x2="3.01" y1="12" y2="12"/><line x1="3" x2="3.01" y1="18" y2="18"/>',
  tree: '<path d="M21 12h-8"/><path d="M21 6H8"/><path d="M21 18h-8"/><path d="M3 6v4c0 1.1.9 2 2 2h3"/><path d="M3 10v6c0 1.1.9 2 2 2h3"/>',
  checkbox:
    '<rect width="20" height="12" x="2" y="6" rx="6" ry="6"/><circle cx="8" cy="12" r="2"/>',
  url: '<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>',
  wysiwyg:
    '<line x1="21" x2="3" y1="6" y2="6"/><line x1="15" x2="3" y1="12" y2="12"/><line x1="17" x2="3" y1="18" y2="18"/>',
  countries:
    '<circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/>',
  currency:
    '<line x1="12" x2="12" y1="2" y2="22"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>',
  percent:
    '<line x1="19" x2="5" y1="5" y2="19"/><circle cx="6.5" cy="6.5" r="2.5"/><circle cx="17.5" cy="17.5" r="2.5"/>',
  signature:
    '<path d="M12 20h9"/><path d="M16.376 3.622a1 1 0 0 1 3.002 3.002L7.368 18.635a2 2 0 0 1-.855.506l-2.872.838a.5.5 0 0 1-.62-.62l.838-2.872a2 2 0 0 1 .506-.854z"/>',
};

const LABELS: Record<string, string> = {
  text: 'Text',
  textarea: 'Text Area',
  email: 'Email',
  phone: 'Phone',
  number: 'Number',
  date: 'Date',
  datetime: 'Date & Time',
  time: 'Time',
  file: 'File',
  dropdown: 'Dropdown',
  tree: 'Tree',
  checkbox: 'Checkbox',
  url: 'URL',
  wysiwyg: 'Rich Text',
  countries: 'Countries',
  currency: 'Currency',
  percent: 'Percent',
  signature: 'Signature',
};

const path = ICON_PATHS[type] ?? ICON_PATHS.text;
const typeLabel = LABELS[type] ?? type;
---

<span class={`ft-badge ft-${type}`} aria-hidden={label ? undefined : 'true'}>
  <span class="ft-icon">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      set:html={path}
    />
  </span>
  {label && <span class="ft-label">{typeLabel}</span>}
</span>

<style>
  .ft-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    vertical-align: middle;
    white-space: nowrap;
  }
  .ft-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 0.5rem;
    background: var(--ft-bg);
    color: var(--ft-fg);
    flex-shrink: 0;
  }
  .ft-label {
    font-weight: 600;
  }

  /* Same accent pairs as web-ui-v2's getFieldTypeColor (tailwind *-100/*-600,
     dark *-900/30 with *-400 text). */
  .ft-text,
  .ft-textarea {
    --ft-bg: #dbeafe;
    --ft-fg: #2563eb;
  }
  .ft-email,
  .ft-currency {
    --ft-bg: #dcfce7;
    --ft-fg: #16a34a;
  }
  .ft-phone {
    --ft-bg: #f3e8ff;
    --ft-fg: #9333ea;
  }
  .ft-number,
  .ft-percent {
    --ft-bg: #ffedd5;
    --ft-fg: #ea580c;
  }
  .ft-date,
  .ft-datetime,
  .ft-time {
    --ft-bg: #fce7f3;
    --ft-fg: #db2777;
  }
  .ft-file {
    --ft-bg: #fef3c7;
    --ft-fg: #d97706;
  }
  .ft-dropdown {
    --ft-bg: #e0e7ff;
    --ft-fg: #4f46e5;
  }
  .ft-tree {
    --ft-bg: #fae8ff;
    --ft-fg: #c026d3;
  }
  .ft-checkbox {
    --ft-bg: #cffafe;
    --ft-fg: #0891b2;
  }
  .ft-wysiwyg {
    --ft-bg: #ccfbf1;
    --ft-fg: #0d9488;
  }
  .ft-countries {
    --ft-bg: #d1fae5;
    --ft-fg: #059669;
  }
  .ft-signature {
    --ft-bg: #ede9fe;
    --ft-fg: #7c3aed;
  }
  .ft-url {
    --ft-bg: #e0f2fe;
    --ft-fg: #0284c7;
  }

  :global([data-theme='dark']) .ft-text,
  :global([data-theme='dark']) .ft-textarea {
    --ft-bg: rgba(30, 58, 138, 0.3);
    --ft-fg: #60a5fa;
  }
  :global([data-theme='dark']) .ft-email,
  :global([data-theme='dark']) .ft-currency {
    --ft-bg: rgba(20, 83, 45, 0.3);
    --ft-fg: #4ade80;
  }
  :global([data-theme='dark']) .ft-phone {
    --ft-bg: rgba(88, 28, 135, 0.3);
    --ft-fg: #c084fc;
  }
  :global([data-theme='dark']) .ft-number,
  :global([data-theme='dark']) .ft-percent {
    --ft-bg: rgba(124, 45, 18, 0.3);
    --ft-fg: #fb923c;
  }
  :global([data-theme='dark']) .ft-date,
  :global([data-theme='dark']) .ft-datetime,
  :global([data-theme='dark']) .ft-time {
    --ft-bg: rgba(131, 24, 67, 0.3);
    --ft-fg: #f472b6;
  }
  :global([data-theme='dark']) .ft-file {
    --ft-bg: rgba(120, 53, 15, 0.3);
    --ft-fg: #fbbf24;
  }
  :global([data-theme='dark']) .ft-dropdown {
    --ft-bg: rgba(49, 46, 129, 0.3);
    --ft-fg: #818cf8;
  }
  :global([data-theme='dark']) .ft-tree {
    --ft-bg: rgba(112, 26, 117, 0.3);
    --ft-fg: #e879f9;
  }
  :global([data-theme='dark']) .ft-checkbox {
    --ft-bg: rgba(22, 78, 99, 0.3);
    --ft-fg: #22d3ee;
  }
  :global([data-theme='dark']) .ft-wysiwyg {
    --ft-bg: rgba(19, 78, 74, 0.3);
    --ft-fg: #2dd4bf;
  }
  :global([data-theme='dark']) .ft-countries {
    --ft-bg: rgba(6, 78, 59, 0.3);
    --ft-fg: #34d399;
  }
  :global([data-theme='dark']) .ft-signature {
    --ft-bg: rgba(76, 29, 149, 0.3);
    --ft-fg: #a78bfa;
  }
  :global([data-theme='dark']) .ft-url {
    --ft-bg: rgba(12, 74, 110, 0.3);
    --ft-fg: #38bdf8;
  }
</style>
