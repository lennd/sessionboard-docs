---
/**
 * A product's badge next to its name (src/lib/product-badges.mjs): the same
 * marks and tones as sessionboard.com's Products menu. Decorative by default,
 * because the name is beside it; pass `label` when it stands alone.
 *
 * Shared with the API Docs product switcher. Colors live in the "Product
 * badges" block of src/styles/custom.css, which every page already loads.
 */
import { productBadgeHtml } from '../lib/product-badges.mjs';

interface Props {
	product: 'platform' | 'marketing' | 'learning' | 'awards' | 'sessions' | 'crm';
	size?: 'sm' | 'md';
	label?: string;
}

const { product, size = 'sm', label } = Astro.props;
---

<Fragment set:html={productBadgeHtml(product, { size, label })} />
