---
/**
 * The "Available with / Where / Turn it on / Requires" box under an article's
 * title — the Help Center's equivalent of the requirements block on every
 * HubSpot Knowledge Base article.
 *
 * Rendered by PageTitle.astro for every article that declares `features` in
 * frontmatter (or any of `where`, `availability`, `enable_path`,
 * `permissions`). The facts come from the product contract that web-api
 * exports — Early Access stage, admin category, scope — so when a feature
 * graduates or moves from beta to preview, every article updates on the next
 * `npm run contract:pull`, and nobody edits 70 pages. Frontmatter overrides
 * exist for the cases the contract cannot know (a menu path, a permission).
 *
 * The box is plain HTML with data attributes so the in-app reader can later
 * personalise it ("On for this event") the way IfFeature is personalised.
 */
import contract from '../data/product-contract.json';
import { AVAILABILITY, ENABLE_HOW, featureFacts } from '../lib/release-notes.mjs';

interface Props {
  features: string[];
  where?: 'org' | 'event' | 'both';
  availability?: keyof typeof AVAILABILITY;
  cs_enabled?: boolean;
  enable_path?: string;
  permissions?: string[];
  /** Product-contract slug this feature ships inside (`crm` for Contracts). */
  included_with?: string;
}

const { features = [], where, availability, cs_enabled, enable_path, included_with, permissions = [] } = Astro.props;

const RANK: Record<string, number> = { everyone: 0, preview: 1, on_request: 2, beta: 3, limited_release: 4, add_on: 5, enterprise: 6 };
const facts = features.map((f) => featureFacts(f, contract));

// Most restrictive wins when an article spans several features.
const derivedAvailability = facts.reduce<string>((acc, f) => (RANK[f.availability] > RANK[acc] ? f.availability : acc), 'everyone');
const avail = availability || derivedAvailability;

const scopes = new Set<string>();
for (const f of facts) for (const s of f.scopes) scopes.add(s);
const derivedWhere = scopes.size === 2 ? 'both' : scopes.size === 1 ? [...scopes][0] : null;
const scope = where || derivedWhere;
const scopeLabel = { org: 'Organization', event: 'Event', both: 'Organization and event' }[scope as string] || null;

const enableHow = facts.find((f) => f.availability === avail)?.enable_how || (avail === 'everyone' ? 'default_on' : 'csm');
// Included with another product (Contracts with CRM, GA 2026-10-28): it is on
// wherever that product is on, so the add-on / CSM wording would be wrong.
const includedName = included_with
  ? (contract.featureNames as Record<string, string>)[included_with] || included_with
  : null;
const INCLUDED_LINKS: Record<string, string> = { crm: '/speaker-crm/overview' };
const includedHref = included_with ? INCLUDED_LINKS[included_with] : undefined;
const sessionboardEnables = includedName ? false : cs_enabled ?? ['beta', 'on_request', 'add_on', 'limited_release', 'enterprise'].includes(avail);

const names = facts.map((f) => f.name);
// "Settings · Update" exists at both scopes; qualify so the two read differently.
const SCOPE_WORD: Record<string, string> = { org: 'Organization', event: 'Event' };
const permissionNames = [
  ...new Set(
    permissions.map((p) => {
      const name = (contract.permissionNames as Record<string, string>)[p] || p;
      const sc = ((contract.permissionScopes as Record<string, string[]>)[p] || [])[0];
      return sc && SCOPE_WORD[sc] ? `${SCOPE_WORD[sc]} ${name}` : name;
    }),
  ),
];
const show = features.length > 0 || where || availability || enable_path || included_with || permissions.length > 0;
---

{show && (
  <aside class="sb-availability" aria-label="Availability" data-sb-availability={features.join(' ') || undefined} data-availability={includedName ? 'included' : avail} data-included-with={included_with} data-pagefind-ignore>
    <dl>
      <div>
        <dt>Available with</dt>
        {includedName ? (
          <dd>
            <strong>Included with {includedName}</strong>
            {names.length > 0 && <span class="sb-availability-names"> · {names.join(', ')}</span>}
            <span class="sb-availability-sub">
              Every organization with {includedName} has it; nothing extra to buy.
              {includedHref && <> <a href={includedHref}>About {includedName}</a></>}
            </span>
          </dd>
        ) : (
          <dd>
            <strong>{AVAILABILITY[avail]?.label}</strong>
            {names.length > 0 && <span class="sb-availability-names"> · {names.join(', ')}</span>}
            <span class="sb-availability-sub">{AVAILABILITY[avail]?.short}</span>
          </dd>
        )}
      </div>
      {scopeLabel && (
        <div>
          <dt>Where</dt>
          <dd>{scopeLabel}</dd>
        </div>
      )}
      <div>
        <dt>Turn it on</dt>
        <dd>
          {enable_path ? enable_path : includedName ? `On whenever ${includedName} is on — nothing to turn on` : ENABLE_HOW[enableHow]}
          {sessionboardEnables && (
            <span class="sb-availability-sub">
              Sessionboard turns this on for you — ask your Customer Success Manager.
            </span>
          )}
        </dd>
      </div>
      {permissionNames.length > 0 && (
        <div>
          <dt>Requires</dt>
          <dd>{permissionNames.join(', ')} permission{permissionNames.length > 1 ? 's' : ''}</dd>
        </div>
      )}
    </dl>
  </aside>
)}

<style>
  /* A quiet strip under the title: one hairline above, no box, no accent
     bar — Starlight's own panel divider closes it below. It reads as
     metadata about the page, not as a callout. */
  .sb-availability {
    margin: 1.75rem 0 0.5rem;
    padding: 1.25rem 0 0;
    border-top: 1px solid var(--sl-color-hairline);
    font-size: var(--sl-text-sm);
  }
  .sb-availability dl {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 0.75rem 2rem;
    margin: 0;
  }
  .sb-availability div {
    min-width: 0;
  }
  .sb-availability dt {
    font-weight: 600;
    color: var(--sl-color-gray-3);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 0.7rem;
    margin-bottom: 0.3rem;
  }
  .sb-availability dd {
    margin: 0;
    color: var(--sl-color-white);
  }
  .sb-availability-names {
    color: var(--sl-color-gray-2);
  }
  .sb-availability-sub {
    display: block;
    color: var(--sl-color-gray-3);
  }
</style>
