---
/**
 * "Get release notes by email" — the public opt-in. Three placements, one
 * component: the card on /help/release-notes, the card under the home-page
 * hero, and the dialog behind "Get updates" in the top bar (SocialIcons.astro).
 * Several instances can share a page (the release-notes page has the card
 * and the header dialog), so every id is derived from `id` and the script
 * initialises each instance it finds.
 *
 * Posts to the Worker (/help/release-notes/subscribe), which relays to
 * sessionboard-web-api. Double opt-in: the visitor gets a confirmation email
 * and nothing is sent until they click it. Works without JavaScript (plain
 * form POST → redirect to /help/release-notes/email?result=…); with it, the
 * card swaps to the outcome in place and announces it to screen readers.
 *
 * Bot defence, none of it visible to a person (the Worker enforces it —
 * src/lib/product-updates-proxy.mjs): `website` is a honeypot (visually
 * hidden, tabindex -1, autocomplete off — bots fill it, people never see
 * it); `t0` is when the card rendered, so a submit a few hundred ms later is
 * a script; and an *invisible* Turnstile widget supplies a token when it
 * loads. If the widget is blocked or slow the form still submits without a
 * token — the API's throttles and the double opt-in are the backstop. The
 * Turnstile script itself is injected once, on the first focus of any
 * instance, so readers who never touch a form never fetch it.
 *
 * The Turnstile widget is "Help Center release-notes opt-in" in the
 * Sessionboard Cloudflare account, bound to learn.sessionboard.com, mode
 * invisible. web-api verifies tokens with that widget's secret
 * (PRODUCT_UPDATES_TURNSTILE_SECRET_KEY). The site key is public.
 */
import { SUBSCRIBE_PATH } from '../lib/product-updates-proxy.mjs';

interface Props {
  /** Unique per instance on a page; prefixes every element id. */
  id?: string;
  /** `card` is the two-column panel; `modal` stacks for the header dialog. */
  variant?: 'card' | 'modal';
  /** Heading level — h2 inside page content, h1 inside the dialog. */
  headingLevel?: 'h1' | 'h2';
  /** On the release-notes page the lede says "here"; elsewhere it links there. */
  onReleaseNotes?: boolean;
}

const {
  id = 'sb-sub',
  variant = 'card',
  headingLevel = 'h2',
  onReleaseNotes = false,
} = Astro.props;

const Heading = headingLevel;
const TURNSTILE_SITE_KEY = '0x4AAAAAAFTeCPKTQumIpeOI';
/** How long to wait for a Turnstile token before submitting without one. */
const TURNSTILE_WAIT_MS = 2500;
---

<section
  class="sb-sub"
  id={id === 'sb-sub' ? 'subscribe' : undefined}
  aria-labelledby={`${id}-title`}
  data-sb-subscribe
  data-variant={variant}
  data-turnstile-site-key={TURNSTILE_SITE_KEY}
  data-turnstile-wait-ms={TURNSTILE_WAIT_MS}
>
  <div class="sb-sub-copy">
    <Heading id={`${id}-title`} class="sb-sub-title">Get release notes by email</Heading>
    <p class="sb-sub-lede">
      A short digest on the days something new goes live — each change with a link to its note {onReleaseNotes ? 'here' : <a href="/help/release-notes">in the release notes</a>}. No marketing, and one click to stop.
    </p>
  </div>
  <form class="sb-sub-form" method="post" action={SUBSCRIBE_PATH} data-sb-subscribe-form novalidate>
    <label class="sb-sub-label" for={`${id}-email`}>Work email</label>
    <div class="sb-sub-row">
      <input
        id={`${id}-email`}
        class="sb-sub-input"
        type="email"
        name="email"
        inputmode="email"
        autocomplete="email"
        required
        maxlength="320"
        placeholder="you@organization.org"
        aria-describedby={`${id}-hint`}
      />
      <button class="sb-sub-button" type="submit">Subscribe</button>
    </div>
    <p id={`${id}-hint`} class="sb-sub-hint">We’ll send one email to confirm it’s you. Already use Sessionboard? You can also turn this on under <strong>Community → What’s new</strong>.</p>
    <div class="sb-sub-hp" aria-hidden="true">
      <label for={`${id}-website`}>Website</label>
      <input id={`${id}-website`} type="text" name="website" tabindex="-1" autocomplete="off" />
    </div>
    <input type="hidden" name="t0" value="" data-sb-subscribe-t0 />
    <div class="sb-sub-turnstile" data-sb-subscribe-turnstile aria-hidden="true"></div>
  </form>
  <p class="sb-sub-status" role="status" aria-live="polite" data-sb-subscribe-status hidden></p>
</section>

<script>
  type Turnstile = {
    render: (el: Element, opts: Record<string, unknown>) => string;
    execute: (id: string) => void;
    reset: (id: string) => void;
  };
  const turnstile = () => (window as unknown as { turnstile?: Turnstile }).turnstile;
  const TURNSTILE_SRC = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
  let turnstileLoad: Promise<Turnstile | undefined> | null = null;
  /** Inject api.js once per page; resolves when `window.turnstile` exists (or on error). */
  const loadTurnstile = (): Promise<Turnstile | undefined> => {
    if (turnstile()) return Promise.resolve(turnstile());
    if (turnstileLoad) return turnstileLoad;
    turnstileLoad = new Promise((resolve) => {
      const existing = document.querySelector<HTMLScriptElement>(`script[src^="${TURNSTILE_SRC}"]`);
      const script = existing ?? document.createElement('script');
      const done = () => resolve(turnstile());
      script.addEventListener('load', done, { once: true });
      script.addEventListener('error', () => resolve(undefined), { once: true });
      if (!existing) {
        script.src = TURNSTILE_SRC;
        script.async = true;
        script.defer = true;
        document.head.appendChild(script);
      }
    });
    return turnstileLoad;
  };

  const MESSAGES: Record<string, string> = {
    check_email: 'Check your inbox — we sent a link to confirm your subscription. It’s good for 24 hours.',
    email_required: 'Enter your email address to subscribe.',
    invalid: 'That doesn’t look like an email address. Check it and try again.',
    slow_down: 'Too many attempts from this network. Try again in an hour.',
    unavailable: 'Email sign-up isn’t open yet — we’re switching it on shortly. Check back soon, or turn it on under Community → What’s new in Sessionboard.',
    error: 'Something went wrong on our side. Try again in a few minutes.',
  };

  function init(root: HTMLElement) {
    if (root.dataset.sbSubscribeReady) return;
    root.dataset.sbSubscribeReady = '1';
    const form = root.querySelector<HTMLFormElement>('[data-sb-subscribe-form]');
    const status = root.querySelector<HTMLElement>('[data-sb-subscribe-status]');
    if (!form || !status) return;
    const input = form.querySelector<HTMLInputElement>('input[name="email"]');
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const t0 = form.querySelector<HTMLInputElement>('[data-sb-subscribe-t0]');
    if (t0) t0.value = String(Date.now());

    // Invisible Turnstile. Rendered lazily on first focus so the script is
    // not fetched for readers who never touch the form; resolves to '' when
    // the widget is blocked, errors, or takes longer than TURNSTILE_WAIT_MS.
    const siteKey = root.dataset.turnstileSiteKey ?? '';
    const waitMs = Number(root.dataset.turnstileWaitMs) || 2500;
    const slot = form.querySelector<HTMLElement>('[data-sb-subscribe-turnstile]');
    let widgetId: string | null = null;
    let pending: ((token: string) => void) | null = null;
    const mountTurnstile = () => {
      const ts = turnstile();
      if (widgetId !== null || !ts || !slot || !siteKey) return;
      try {
        widgetId = ts.render(slot, {
          sitekey: siteKey,
          execution: 'execute',
          callback: (token: string) => pending?.(token),
          'error-callback': () => pending?.(''),
          'expired-callback': () => pending?.(''),
          'timeout-callback': () => pending?.(''),
        });
      } catch {
        widgetId = null;
      }
    };
    input?.addEventListener('focus', () => loadTurnstile().then(mountTurnstile), { once: true });
    const turnstileToken = (): Promise<string> =>
      new Promise((resolve) => {
        let settled = false;
        const finish = (token: string) => {
          if (settled) return;
          settled = true;
          window.clearTimeout(timer);
          pending = null;
          resolve(token);
        };
        // One budget covers script load + challenge; past it we submit without a token.
        const timer = window.setTimeout(() => finish(''), waitMs);
        loadTurnstile().then((ts) => {
          mountTurnstile();
          if (settled) return;
          if (widgetId === null || !ts) return finish('');
          pending = finish;
          try {
            ts.execute(widgetId);
          } catch {
            finish('');
          }
        });
      });
    const show = (key: string, ok: boolean) => {
      status.textContent = MESSAGES[key] ?? MESSAGES.error;
      status.hidden = false;
      status.dataset.state = ok ? 'ok' : 'error';
      if (ok) form.hidden = true;
    };
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const email = (input?.value ?? '').trim().toLowerCase();
      if (input && input.value !== email) input.value = email;
      if (!email || !input?.checkValidity()) {
        show(email ? 'invalid' : 'email_required', false);
        input?.focus();
        return;
      }
      if (button) button.disabled = true;
      status.hidden = true;
      try {
        const token = await turnstileToken();
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            email,
            website: form.querySelector<HTMLInputElement>('input[name="website"]')?.value ?? '',
            t0: t0?.value ?? '',
            turnstileToken: token || undefined,
          }),
        });
        const body = await res.json().catch(() => ({}));
        show(body.result ?? body.error ?? (res.ok ? 'check_email' : 'error'), Boolean(body.ok));
      } catch {
        show('error', false);
      } finally {
        if (button) button.disabled = false;
        const ts = turnstile();
        if (ts && widgetId !== null) {
          try {
            ts.reset(widgetId);
          } catch {
            /* a fresh token is fetched on the next submit anyway */
          }
        }
      }
    });
  }

  document.querySelectorAll<HTMLElement>('[data-sb-subscribe]').forEach(init);
</script>

<style>
  .sb-sub {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: 1.25rem 2rem;
    align-items: center;
    margin: 1.5rem 0 0;
    padding: 1.25rem 1.4rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.9rem;
    background: var(--sl-color-accent-low);
  }
  .sb-sub[data-variant='modal'] {
    grid-template-columns: 1fr;
    gap: 1rem;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
  }
  :global(.sl-markdown-content) .sb-sub-title,
  .sb-sub-title {
    margin: 0;
    font-size: var(--sl-text-lg);
    line-height: 1.3;
    color: var(--sl-color-white);
  }
  .sb-sub[data-variant='modal'] .sb-sub-title {
    font-size: var(--sl-text-xl);
  }
  .sb-sub-lede {
    margin: 0.35rem 0 0;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }
  .sb-sub-lede a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
  .sb-sub-form {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .sb-sub-label {
    font-size: var(--sl-text-xs);
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
  }
  .sb-sub-row {
    display: flex;
    gap: 0.5rem;
  }
  .sb-sub-input {
    flex: 1 1 auto;
    min-width: 0;
    font: inherit;
    font-size: var(--sl-text-sm);
    padding: 0.55rem 0.75rem;
    border-radius: 0.5rem;
    border: 1px solid var(--sl-color-gray-5);
    background: var(--sl-color-bg);
    color: var(--sl-color-white);
  }
  .sb-sub-input:focus-visible,
  .sb-sub-button:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }
  .sb-sub-button {
    font: inherit;
    font-size: var(--sl-text-sm);
    font-weight: 600;
    padding: 0.55rem 1rem;
    border-radius: 0.5rem;
    border: 1px solid var(--sb-btn-border, var(--sl-color-accent));
    background: var(--sb-btn, var(--sl-color-accent));
    color: #fff;
    cursor: pointer;
    white-space: nowrap;
  }
  .sb-sub-button:hover {
    filter: brightness(1.06);
  }
  .sb-sub-button[disabled] {
    opacity: 0.6;
    cursor: progress;
  }
  .sb-sub-hint {
    margin: 0.1rem 0 0;
    font-size: var(--sl-text-xs);
    line-height: 1.5;
    color: var(--sl-color-gray-3);
  }
  .sb-sub-hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  /* Invisible widget: renders nothing visible, but needs a box in the DOM. */
  .sb-sub-turnstile {
    height: 0;
    overflow: hidden;
  }
  .sb-sub-status {
    grid-column: 1 / -1;
    margin: 0;
    padding: 0.6rem 0.8rem;
    border-radius: 0.5rem;
    font-size: var(--sl-text-sm);
    border: 1px solid var(--sl-color-hairline);
    background: var(--sl-color-bg);
  }
  .sb-sub-status[data-state='ok'] {
    border-color: var(--sl-color-green);
    color: var(--sl-color-green-high);
    background: var(--sl-color-green-low);
  }
  .sb-sub-status[data-state='error'] {
    border-color: var(--sl-color-red);
    color: var(--sl-color-red-high);
    background: var(--sl-color-red-low);
  }
  @media (max-width: 50rem) {
    .sb-sub {
      grid-template-columns: 1fr;
    }
    .sb-sub-row {
      flex-direction: column;
    }
  }
</style>
