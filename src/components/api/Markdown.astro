---
import { renderMarkdown } from '../../lib/api-docs/markdown.mjs';
import { indexFor, registry } from '../../lib/api-docs/data';
interface Props { text?: string; inline?: boolean; product?: string }
const { text, inline = false, product = 'platform' } = Astro.props;
let html = await renderMarkdown(text, { index: indexFor(product), fallback: indexFor('platform'), registry });
// A one-paragraph description inside a field row reads better without the <p> margins.
if (inline) html = html.replace(/^<p>([\s\S]*?)<\/p>\s*$/, '$1');
---
{html && (inline ? <span class="api-md" set:html={html} /> : <div class="api-md" set:html={html} />)}
