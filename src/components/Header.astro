---
/**
 * Starlight's header plus the top-level tabs: "Help Center" (every guide),
 * "Academy" (lessons, exams and certifications — src/lib/academy.mjs) and
 * "API Docs" (the API docs of the product you are in: Platform's /api, or a self-serve
 * product's /sessionboard-<key>/api when that product is built). Markup and layout are
 * Starlight's own Header.astro; only the tab bar and the API product switcher are new.
 * Each tab's sidebar is chosen in src/route-data.ts.
 *
 * The switcher ("API for: Platform ▾") appears on API pages only, and only when the
 * signed-in reader holds two or more products whose API docs are in this build: their
 * products come from /_account/me `products` (web-api /help/reader/me), Platform when
 * the API does not say. Preview builds (SB_PREVIEW_SUITES) also take ?as=platform,marketing
 * so the local preview can show any combination without the Worker.
 */
import config from 'virtual:starlight/user-config';
import { getCollection } from 'astro:content';

import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import SocialIcons from 'virtual:starlight/components/SocialIcons';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
import { apiProductAt, builtProducts, registry } from '../lib/api-docs/data';
import { PLATFORM } from '../lib/api-docs/products.mjs';
import site from '../../site.json';
import ProductBadge from './ProductBadge.astro';

const shouldRenderSearch =
	config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';

const path = Astro.url.pathname;
const products = builtProducts();
const onApi = apiProductAt(path);
// The product whose Help Center suite this page is in (by its `help` folder), for the API Docs tab.
const suiteProduct =
	onApi ??
	products.find((P) => {
		const dir = P.help.split('/').filter(Boolean)[0];
		return P.key !== PLATFORM && dir && (path === `/${dir}` || path.startsWith(`/${dir}/`));
	}) ??
	products.find((P) => P.key === PLATFORM)!;
// A product's Help Center home lives in its suite (docs-suites); fall back to the site root
// when that suite is not in this build.
const helpIds = new Set((await getCollection('docs')).map((e) => e.id));
const helpHref = onApi && onApi.help !== '/' && helpIds.has(onApi.help.replace(/^\//, '')) ? onApi.help : '/';
// The Academy (src/lib/academy.mjs): our own Learning Site's paths, surfaced here.
// The build renders /academy as academy.html, so normalise before matching.
const academyPath = path.replace(/\.html$/, '').replace(/\/$/, '');
const onAcademy = academyPath === '/academy' || academyPath.startsWith('/academy/');
const tabs = [
	{ label: 'Help Center', short: 'Help', href: helpHref, current: !onApi && !onAcademy },
	// ?via=all clears a self-serve help scope (src/lib/help-scope.mjs), which would otherwise hide
	// the API sidebar's untagged links.
	{ label: 'API Docs', short: 'API', href: `${suiteProduct.base}?via=all`, current: Boolean(onApi) },
	// Shown once the Academy is open (site.json `academy.open`), and always on /academy itself.
	...((site as { academy?: { open?: boolean } }).academy?.open === true || onAcademy
		? [{ label: 'Academy', short: 'Academy', href: '/academy', current: onAcademy }]
		: []),
];
const preview = products.some((P) => !(registry.products as Record<string, { released?: boolean }>)[P.key]?.released);
const switchable = onApi && products.length > 1;
---

<div class="header">
	<div class="title-wrapper sl-flex">
		<SiteTitle />
		<nav class="sb-top-tabs print:hidden" aria-label="Documentation">
			{
				tabs.map((t) => (
					<a href={t.href} aria-current={t.current ? 'page' : undefined} aria-label={t.label} data-tab={t.short.toLowerCase()}>
						<span class="sb-tab-long">{t.label}</span>
						<span class="sb-tab-short" aria-hidden="true">{t.short}</span>
					</a>
				))
			}
		</nav>
		{
			switchable && (
				<details class="sb-api-switch print:hidden" data-current={onApi!.key} data-preview={preview ? '1' : undefined} hidden>
					<summary aria-label={`API docs for ${onApi!.label}. Switch product`}>
						<span class="sb-api-switch-for">API for</span>
						<ProductBadge product={onApi!.key as 'platform'} />
						{onApi!.label}
					</summary>
					<ul>
						{products.map((P) => (
							<li data-product={P.key} hidden>
								<a href={`${P.base}?via=all`} aria-current={P.key === onApi!.key ? 'page' : undefined}>
									<ProductBadge product={P.key as 'platform'} />
									{P.label}
								</a>
							</li>
						))}
					</ul>
				</details>
			)
		}
	</div>
	<div class="sl-flex print:hidden">
		{shouldRenderSearch && <Search />}
	</div>
	<div class="sl-hidden md:sl-flex print:hidden right-group">
		<div class="sl-flex social-icons">
			<SocialIcons />
		</div>
		<ThemeSelect />
		<LanguageSelect />
	</div>
</div>

<script>
	// Show only the products the reader holds (Platform when the API does not say), and the
	// switcher only when that is two or more. Preview builds accept ?as=a,b to simulate a token.
	const sw = document.querySelector<HTMLDetailsElement>('.sb-api-switch');
	if (sw) {
		const KEY = 'sb-api-preview-products';
		const fromQuery = sw.dataset.preview ? new URLSearchParams(location.search).get('as') : null;
		if (fromQuery !== null) {
			try {
				sessionStorage.setItem(KEY, fromQuery);
			} catch {}
		}
		let simulated: string | null = null;
		try {
			simulated = sw.dataset.preview ? sessionStorage.getItem(KEY) : null;
		} catch {}
		const apply = (held: string[]) => {
			const items = [...sw.querySelectorAll<HTMLElement>('li[data-product]')];
			let shown = 0;
			for (const li of items) {
				const on = held.includes(li.dataset.product!) || li.dataset.product === sw.dataset.current;
				li.hidden = !on;
				if (on) shown++;
			}
			sw.hidden = shown < 2;
		};
		if (simulated) apply(simulated.split(',').map((s) => s.trim()).filter(Boolean));
		else
			fetch('/_account/me', { credentials: 'same-origin', headers: { Accept: 'application/json' } })
				.then((r) => (r.ok ? r.json() : null))
				.then((body) => apply(Array.isArray(body?.reader?.products) ? body.reader.products : ['platform']))
				.catch(() => apply(['platform']));
		document.addEventListener('click', (e) => {
			if (sw.open && !sw.contains(e.target as Node)) sw.open = false;
		});
	}
</script>

<style>
	@layer starlight.core {
		.header {
			display: flex;
			gap: var(--sl-nav-gap);
			justify-content: space-between;
			align-items: center;
			height: 100%;
		}

		.title-wrapper {
			/* Clip long titles sideways (Starlight's reason), but let the API switcher's menu drop below. */
			overflow-x: clip;
			overflow-y: visible;
			padding: 0.25rem;
			margin: -0.25rem;
			min-width: 0;
			align-items: center;
			gap: 1rem;
		}

		.right-group,
		.social-icons {
			gap: 1rem;
			align-items: center;
		}
		.social-icons::after {
			content: '';
			height: 2rem;
			border-inline-end: 1px solid var(--sl-color-gray-5);
		}

		@media (min-width: 50rem) {
			:global(:root[data-has-sidebar]) {
				--__sidebar-pad: calc(2 * var(--sl-nav-pad-x));
			}
			:global(:root:not([data-has-toc])) {
				--__toc-width: 0rem;
			}
			.header {
				--__sidebar-width: max(0rem, var(--sl-content-inline-start, 0rem) - var(--sl-nav-pad-x));
				--__main-column-fr: calc(
					(
							100% + var(--__sidebar-pad, 0rem) - var(--__toc-width, var(--sl-sidebar-width)) -
								(2 * var(--__toc-width, var(--sl-nav-pad-x))) - var(--sl-content-inline-start, 0rem) -
								var(--sl-content-width)
						) / 2
				);
				display: grid;
				grid-template-columns:
					minmax(
						calc(var(--__sidebar-width) + max(0rem, var(--__main-column-fr) - var(--sl-nav-gap))),
						auto
					)
					1fr
					auto;
				align-content: center;
			}
		}
	}

	.sb-top-tabs {
		display: flex;
		align-items: stretch;
		gap: 0.25rem;
		flex-shrink: 0;
		height: 100%;
	}
	.sb-top-tabs a {
		display: inline-flex;
		align-items: center;
		padding: 0.25rem 0.6rem;
		border-radius: 0.4rem;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		color: var(--sl-color-gray-2);
		text-decoration: none;
		white-space: nowrap;
		position: relative;
	}
	.sb-top-tabs a:hover {
		color: var(--sl-color-white);
		background: var(--sl-color-gray-6);
	}
	.sb-top-tabs a[aria-current='page'] {
		color: var(--sl-color-text-accent);
	}
	.sb-top-tabs a[aria-current='page']::after {
		content: '';
		position: absolute;
		inset-inline: 0.6rem;
		bottom: -0.35rem;
		height: 2px;
		border-radius: 2px;
		background: var(--sl-color-text-accent);
	}
	.sb-tab-short {
		display: none;
	}
	.sb-api-switch {
		position: relative;
		flex-shrink: 0;
		font-size: var(--sl-text-sm);
	}
	.sb-api-switch > summary {
		list-style: none;
		cursor: pointer;
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.25rem 0.6rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 999px;
		font-weight: 600;
		color: var(--sl-color-white);
		white-space: nowrap;
	}
	.sb-api-switch > summary::-webkit-details-marker {
		display: none;
	}
	.sb-api-switch > summary::after {
		content: '▾';
		font-size: 0.75em;
		color: var(--sl-color-gray-3);
	}
	.sb-api-switch-for {
		font-weight: 400;
		color: var(--sl-color-gray-3);
	}
	.sb-api-switch ul {
		position: absolute;
		z-index: 30;
		top: calc(100% + 0.4rem);
		/* Opens leftward from the pill so it stays inside the title area, which clips sideways. */
		inset-inline-end: 0;
		min-width: 11rem;
		margin: 0;
		padding: 0.3rem;
		list-style: none;
		background: var(--sl-color-bg);
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		box-shadow: var(--sl-shadow-md);
	}
	.sb-api-switch li a {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.35rem 0.6rem;
		border-radius: 0.35rem;
		color: var(--sl-color-gray-2);
		text-decoration: none;
	}
	.sb-api-switch li a:hover {
		background: var(--sl-color-gray-6);
		color: var(--sl-color-white);
	}
	.sb-api-switch li a[aria-current='page'] {
		color: var(--sl-color-text-accent);
		font-weight: 600;
	}
	@media (max-width: 50rem) {
		.sb-top-tabs a {
			padding: 0.25rem 0.4rem;
		}
		.sb-tab-long {
			display: none;
		}
		.sb-tab-short {
			display: inline;
		}
		.title-wrapper {
			gap: 0.5rem;
		}
		.sb-api-switch-for {
			display: none;
		}
	}
</style>
