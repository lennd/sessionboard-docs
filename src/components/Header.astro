---
/**
 * Starlight's header plus the top-level tabs: "Help Center" (every guide),
 * "Academy" (lessons, exams and certifications — src/lib/academy.mjs) and
 * "API Docs" (the API docs of the product you are in: Platform's /api, or a self-serve
 * product's /sessionboard-<key>/api when that product is built). Markup and layout are
 * Starlight's own Header.astro; only the tab bar is new. Each tab's sidebar is chosen in
 * src/route-data.ts, and each tab's product dropdown ("Help for", "API for", "Skills for")
 * sits at the top of that sidebar (ProductSwitch.astro).
 */
import config from 'virtual:starlight/user-config';
import { getCollection } from 'astro:content';

import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import SocialIcons from 'virtual:starlight/components/SocialIcons';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
import { apiProductAt, builtProducts } from '../lib/api-docs/data';
import { PLATFORM } from '../lib/api-docs/products.mjs';
import site from '../../site.json';
import { academyOpen } from '../lib/academy.mjs';

const shouldRenderSearch =
	config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';

const path = Astro.url.pathname;
const products = builtProducts();
const onApi = apiProductAt(path);
// The product whose Help Center suite this page is in (by its `help` folder), for the API Docs tab.
const suiteProduct =
	onApi ??
	products.find((P) => {
		const dir = P.help.split('/').filter(Boolean)[0];
		return P.key !== PLATFORM && dir && (path === `/${dir}` || path.startsWith(`/${dir}/`));
	}) ??
	products.find((P) => P.key === PLATFORM)!;
// A product's Help Center home lives in its suite (docs-suites); fall back to the site root
// when that suite is not in this build.
const helpIds = new Set((await getCollection('docs')).map((e) => e.id));
const helpHref = onApi && onApi.help !== '/' && helpIds.has(onApi.help.replace(/^\//, '')) ? onApi.help : '/';
// The Academy (src/lib/academy.mjs): our own Learning Site's paths, surfaced here.
// The build renders /academy as academy.html, so normalise before matching.
const academyPath = path.replace(/\.html$/, '').replace(/\/$/, '');
const onAcademy = academyPath === '/academy' || academyPath.startsWith('/academy/');
// The Skills tab (src/lib/skills.mjs): workflow skills for Claude, ChatGPT and other assistants.
const onSkills = academyPath === '/skills' || academyPath.startsWith('/skills/');
const tabs = [
	{ label: 'Help Center', short: 'Help', href: helpHref, current: !onApi && !onAcademy && !onSkills },
	// ?via=all clears a self-serve help scope (src/lib/help-scope.mjs), which would otherwise hide
	// the API sidebar's untagged links.
	{ label: 'API Docs', short: 'API', href: `${suiteProduct.base}?via=all`, current: Boolean(onApi) },
	{ label: 'Skills', short: 'Skills', href: '/skills', current: onSkills },
	// Shown once the Academy is open (site.json `academy.open`), and always on /academy itself.
	...(academyOpen(site) || onAcademy
		? [{ label: 'Academy', short: 'Academy', href: '/academy', current: onAcademy }]
		: []),
];
---

<div class="header">
	<div class="title-wrapper sl-flex">
		<SiteTitle />
		<nav class="sb-top-tabs print:hidden" aria-label="Documentation">
			{
				tabs.map((t) => (
					<a href={t.href} aria-current={t.current ? 'page' : undefined} aria-label={t.label} data-tab={t.short.toLowerCase()}>
						<span class="sb-tab-long">{t.label}</span>
						<span class="sb-tab-short" aria-hidden="true">{t.short}</span>
					</a>
				))
			}
		</nav>
	</div>
	<div class="sl-flex print:hidden">
		{shouldRenderSearch && <Search />}
	</div>
	<div class="sl-hidden md:sl-flex print:hidden right-group">
		<div class="sl-flex social-icons">
			<SocialIcons />
		</div>
		<ThemeSelect />
		<LanguageSelect />
	</div>
</div>


<style>
	@layer starlight.core {
		.header {
			display: flex;
			gap: var(--sl-nav-gap);
			justify-content: space-between;
			align-items: center;
			height: 100%;
		}

		.title-wrapper {
			/* Clip long titles sideways (Starlight's reason), but let the API switcher's menu drop below. */
			overflow-x: clip;
			overflow-y: visible;
			padding: 0.25rem;
			margin: -0.25rem;
			min-width: 0;
			align-items: center;
			gap: 1rem;
		}

		.right-group,
		.social-icons {
			gap: 1rem;
			align-items: center;
		}
		.social-icons::after {
			content: '';
			height: 2rem;
			border-inline-end: 1px solid var(--sl-color-gray-5);
		}

		@media (min-width: 50rem) {
			:global(:root[data-has-sidebar]) {
				--__sidebar-pad: calc(2 * var(--sl-nav-pad-x));
			}
			:global(:root:not([data-has-toc])) {
				--__toc-width: 0rem;
			}
			.header {
				--__sidebar-width: max(0rem, var(--sl-content-inline-start, 0rem) - var(--sl-nav-pad-x));
				--__main-column-fr: calc(
					(
							100% + var(--__sidebar-pad, 0rem) - var(--__toc-width, var(--sl-sidebar-width)) -
								(2 * var(--__toc-width, var(--sl-nav-pad-x))) - var(--sl-content-inline-start, 0rem) -
								var(--sl-content-width)
						) / 2
				);
				display: grid;
				grid-template-columns:
					minmax(
						calc(var(--__sidebar-width) + max(0rem, var(--__main-column-fr) - var(--sl-nav-gap))),
						auto
					)
					1fr
					auto;
				align-content: center;
			}
		}
	}

	.sb-top-tabs {
		display: flex;
		align-items: stretch;
		gap: 0.25rem;
		flex-shrink: 0;
		height: 100%;
	}
	.sb-top-tabs a {
		display: inline-flex;
		align-items: center;
		padding: 0.25rem 0.6rem;
		border-radius: 0.4rem;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		color: var(--sl-color-gray-2);
		text-decoration: none;
		white-space: nowrap;
		position: relative;
	}
	.sb-top-tabs a:hover {
		color: var(--sl-color-white);
		background: var(--sl-color-gray-6);
	}
	.sb-top-tabs a[aria-current='page'] {
		color: var(--sl-color-text-accent);
	}
	.sb-top-tabs a[aria-current='page']::after {
		content: '';
		position: absolute;
		inset-inline: 0.6rem;
		bottom: -0.35rem;
		height: 2px;
		border-radius: 2px;
		background: var(--sl-color-text-accent);
	}
	.sb-tab-short {
		display: none;
	}
	@media (max-width: 50rem) {
		.sb-top-tabs a {
			padding: 0.25rem 0.4rem;
		}
		.sb-tab-long {
			display: none;
		}
		.sb-tab-short {
			display: inline;
		}
		.title-wrapper {
			gap: 0.5rem;
		}
		}
</style>
