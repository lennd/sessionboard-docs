---
/**
 * Chrome for the staff-only enablement section.
 *
 * Wraps Starlight's page shell so the section looks like the Help Center, but
 * swaps in its own sidebar, disables search indexing (`pagefind: false`) and
 * the table of contents, and puts an "internal" banner above every page.
 * Head.astro adds the noindex meta for any path under the prefix; worker.js
 * adds the matching header and excludes it from caching; astro.config.mjs
 * filters it from the sitemap; it is never linked from a public page (CI:
 * scripts/check-internal.mjs).
 */
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import site from '../../../site.json';
import { MODULES, allEntries, internalPrefix, loadReleaseNotes } from '../../lib/release-notes.mjs';
import { enablementSidebar } from '../../lib/enablement.mjs';

interface Props {
  title: string;
  description?: string;
  current: string;
}

const { title, description = '', current } = Astro.props;
const prefix = internalPrefix(site);
const { releases } = loadReleaseNotes();
const present = new Set(allEntries(releases).map((e) => e.module));
const modulesPresent = MODULES.filter((m) => present.has(m));
const sidebar = enablementSidebar(site, { modulesPresent });
---

<StarlightPage frontmatter={{ title, description, pagefind: false, tableOfContents: false }} sidebar={sidebar} hasSidebar>
  <div class="sb-en-banner" role="note">
    <strong>Internal.</strong> For Sessionboard staff. This section is unlisted and not indexed, but it is not
    password-protected — do not paste these URLs into customer channels. Send customers to
    <a href="/help/release-notes">Release notes</a> and the linked guides.
  </div>
  <slot />
</StarlightPage>

<style is:global>
  /* No right rail here, so let the content use the room (this stylesheet only loads on enablement pages). */
  :root {
    --sl-content-width: 62rem;
  }
  .sb-en-banner {
    margin: 0 0 1.25rem;
    padding: 0.6rem 0.9rem;
    border-radius: 0.6rem;
    border: 1px solid #f0c36d;
    background: #fff7e6;
    color: #6b4a00;
    font-size: var(--sl-text-sm);
  }
  :root[data-theme='dark'] .sb-en-banner {
    border-color: #6b4a00;
    background: #2e2410;
    color: #ffd98a;
  }
  .sb-en-banner a {
    color: inherit;
  }

  /* Toolbars and filters */
  .sb-en-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    margin: 1rem 0 0.5rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.75rem;
    background: var(--sl-color-gray-7, var(--sl-color-bg));
    font-size: var(--sl-text-sm);
  }
  .sb-en-toolbar label {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--sl-color-gray-3);
  }
  .sb-en-toolbar select {
    font: inherit;
    padding: 0.3rem 0.55rem;
    border-radius: 0.5rem;
    border: 1px solid var(--sl-color-gray-5);
    background: var(--sl-color-bg);
    color: var(--sl-color-white);
  }
  .sb-en-count {
    margin-left: auto;
    color: var(--sl-color-gray-3);
  }

  /* Badges and status pills */
  .sb-badge {
    display: inline-block;
    padding: 0.1rem 0.55rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    border: 1px solid var(--sl-color-gray-5);
    color: var(--sl-color-gray-2);
    background: var(--sl-color-gray-7, transparent);
    white-space: nowrap;
  }
  .sb-badge-module {
    background: var(--sl-color-accent-low);
    border-color: transparent;
    color: var(--sl-color-accent-high);
  }
  .sb-badge-new { border-color: transparent; background: #e7f6ec; color: #176b3a; }
  .sb-badge-improved { border-color: transparent; background: #eef1ff; color: #3b45a8; }
  .sb-badge-fixed { border-color: transparent; background: #fff4e5; color: #8a5300; }
  :root[data-theme='dark'] .sb-badge-new { background: #15351f; color: #8ad8a6; }
  :root[data-theme='dark'] .sb-badge-improved { background: #1e2448; color: #aeb6ff; }
  :root[data-theme='dark'] .sb-badge-fixed { background: #3a2a0e; color: #ffcf8a; }

  .sb-badge-cs-danger { border-color: transparent; background: #fde8e8; color: #9b1c1c; }
  .sb-badge-cs-warn { border-color: transparent; background: #fff4e5; color: #8a5300; }
  .sb-badge-cs-info { border-color: transparent; background: #e6f1ff; color: #1e4ea8; }
  .sb-badge-cs-muted { color: var(--sl-color-gray-3); }
  :root[data-theme='dark'] .sb-badge-cs-danger { background: #3d1515; color: #ff9d9d; }
  :root[data-theme='dark'] .sb-badge-cs-warn { background: #3a2a0e; color: #ffcf8a; }
  :root[data-theme='dark'] .sb-badge-cs-info { background: #142848; color: #9dc0ff; }

  .sb-status {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 600;
    white-space: nowrap;
  }
  .sb-status::before {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: currentColor;
  }
  .sb-status-live { background: #e7f6ec; color: #176b3a; }
  .sb-status-partial { background: #fff4e5; color: #8a5300; }
  .sb-status-staged { background: #fde8e8; color: #9b1c1c; }
  :root[data-theme='dark'] .sb-status-live { background: #15351f; color: #8ad8a6; }
  :root[data-theme='dark'] .sb-status-partial { background: #3a2a0e; color: #ffcf8a; }
  :root[data-theme='dark'] .sb-status-staged { background: #3d1515; color: #ff9d9d; }

  /* Entry cards */
  .sb-en-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .sb-en-card {
    margin: 0 0 0.9rem;
    padding: 1rem 1.15rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.75rem;
    background: var(--sl-color-bg);
  }
  .sb-en-card[data-state='staged'],
  .sb-en-card[data-state='partial'] {
    border-color: #f0c36d;
    background: color-mix(in srgb, #fff7e6 55%, var(--sl-color-bg));
  }
  :root[data-theme='dark'] .sb-en-card[data-state='staged'],
  :root[data-theme='dark'] .sb-en-card[data-state='partial'] {
    border-color: #6b4a00;
    background: color-mix(in srgb, #2e2410 45%, var(--sl-color-bg));
  }
  .sb-en-card-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
  }
  .sb-en-card-title {
    font-size: var(--sl-text-lg);
    margin: 0 !important;
    line-height: 1.3;
  }
  .sb-en-card-title a {
    color: inherit;
    text-decoration: none;
  }
  .sb-en-card-title a:hover {
    text-decoration: underline;
  }
  .sb-en-badges {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
  }
  .sb-en-card p {
    margin: 0.5rem 0 0 !important;
  }
  .sb-en-why {
    color: var(--sl-color-gray-2);
  }
  .sb-en-facts {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.25rem 1rem;
    margin: 0.75rem 0 0 !important;
    padding-top: 0.6rem;
    border-top: 1px dashed var(--sl-color-hairline);
    font-size: var(--sl-text-sm);
  }
  .sb-en-facts dt {
    font-weight: 600;
    color: var(--sl-color-gray-3);
  }
  .sb-en-facts dd {
    margin: 0;
  }
  .sb-en-facts dd .sb-muted,
  .sb-muted {
    color: var(--sl-color-gray-3);
  }
  .sb-en-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    margin-top: 0.7rem !important;
    font-size: var(--sl-text-sm);
  }

  /* Detail page */
  .sb-en-hero {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }
  .sb-en-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1rem;
    margin: 1.25rem 0;
  }
  .sb-en-panel {
    padding: 0.9rem 1.1rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.75rem;
    background: var(--sl-color-bg);
  }
  .sb-en-panel h2,
  .sb-en-panel h3 {
    margin: 0 0 0.5rem !important;
    font-size: var(--sl-text-base);
    color: var(--sl-color-gray-3);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-weight: 600;
  }
  .sb-en-panel p,
  .sb-en-panel ul {
    margin: 0.35rem 0 0 !important;
  }
  .sb-en-panel ul {
    padding-left: 1.1rem;
  }
  .sb-en-panel-wide {
    grid-column: 1 / -1;
  }
  .sb-en-panel-cs {
    border-left: 4px solid #c27c00;
  }
  .sb-en-panel-staged {
    border-left: 4px solid #c81e1e;
  }

  .sb-en-video {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    margin-top: 0.5rem;
  }
  .sb-en-video img {
    width: 7rem;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 0.4rem;
    border: 1px solid var(--sl-color-hairline);
  }

  /* Matrix table */
  .sb-en-table-wrap {
    overflow-x: auto;
    margin-top: 1rem;
  }
  table.sb-en-table {
    width: 100%;
    font-size: var(--sl-text-sm);
    border-collapse: collapse;
  }
  table.sb-en-table th,
  table.sb-en-table td {
    padding: 0.45rem 0.6rem;
    border-bottom: 1px solid var(--sl-color-hairline);
    vertical-align: top;
    text-align: left;
  }
  table.sb-en-table th {
    position: sticky;
    top: 0;
    background: var(--sl-color-bg);
  }
</style>
