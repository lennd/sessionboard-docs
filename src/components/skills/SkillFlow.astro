---
/**
 * "You ask → It works → You get" for one skill (src/lib/skill-flow.mjs), under the
 * action row on its page. Real text throughout; the outcome drawing is decorative.
 * Three columns from 40rem, stacked below.
 */
import { flowFor, OUTCOMES } from '../../lib/skill-flow.mjs';

interface Props {
	skill: { product: string; prompts?: string[]; starterPrompt?: string; tools: { title: string; access: string }[] };
}
const { skill } = Astro.props;
const { ask, steps } = flowFor(skill);
const outcome = OUTCOMES[skill.product as keyof typeof OUTCOMES] ?? OUTCOMES.insights;
---

<figure class="sb-flow not-content" aria-label="How this skill works">
	<div class="sb-flow-col">
		<p class="sb-flow-head">You ask</p>
		<p class="sb-flow-ask">{ask}</p>
	</div>
	<span class="sb-flow-arrow" aria-hidden="true"></span>
	<div class="sb-flow-col">
		<p class="sb-flow-head">It works</p>
		<ol class="sb-flow-steps">
			{
				steps.map((s) => (
					<li data-kind={s.kind}>
						{s.kind === 'done' && (
							<svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
								<path d="m3.5 8.5 3 3 6-7" />
							</svg>
						)}
						{s.kind === 'wait' && (
							<svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
								<path d="M6 4v8M10 4v8" />
							</svg>
						)}
						<span>{s.label}</span>
						{s.kind === 'next' && <span class="sr-only"> (after your OK)</span>}
					</li>
				))
			}
		</ol>
	</div>
	<span class="sb-flow-arrow" aria-hidden="true"></span>
	<div class="sb-flow-col">
		<p class="sb-flow-head" data-accent>You get</p>
		<div class="sb-flow-get">
			<Fragment set:html={outcome.svg} />
			<p>{outcome.label}</p>
		</div>
	</div>
</figure>

<style>
	.sb-flow {
		--sb-flow-bg: var(--sl-color-bg-nav);
		display: grid;
		grid-template-columns: 1fr;
		gap: 0.75rem;
		margin: 1.25rem 0 0;
		padding: 1rem;
		border: 1px solid var(--sl-color-hairline);
		border-radius: 0.75rem;
		background: var(--sb-flow-bg);
	}
	@media (min-width: 40rem) {
		.sb-flow {
			grid-template-columns: minmax(0, 1fr) 1.5rem minmax(0, 1.1fr) 1.5rem minmax(0, 1fr);
			align-items: stretch;
			padding: 1.25rem;
		}
	}
	.sb-flow-col {
		display: flex;
		flex-direction: column;
		min-width: 0;
	}
	.sb-flow-head {
		margin: 0 0 0.5rem;
		font-family: var(--__sl-font-mono, ui-monospace, Menlo, monospace);
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--sl-color-gray-2);
	}
	.sb-flow-head[data-accent] {
		color: var(--sl-color-text-accent);
	}
	.sb-flow-ask {
		flex: 1;
		margin: 0;
		padding: 0.75rem 0.9rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.75rem 0.75rem 0.75rem 0.2rem;
		background: var(--sl-color-bg);
		font-size: var(--sl-text-sm);
		line-height: 1.45;
		color: var(--sl-color-white);
	}
	.sb-flow-arrow {
		align-self: center;
		justify-self: center;
		width: 2px;
		height: 1.25rem;
		background: repeating-linear-gradient(var(--sl-color-accent) 0 3px, transparent 3px 7px);
	}
	@media (min-width: 40rem) {
		.sb-flow-arrow {
			width: 100%;
			height: 2px;
			margin-top: 1.4rem;
			background: repeating-linear-gradient(90deg, var(--sl-color-accent) 0 3px, transparent 3px 7px);
		}
	}
	.sb-flow-steps {
		display: grid;
		gap: 0.35rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.sb-flow-steps li {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		min-height: 2rem;
		padding: 0.3rem 0.6rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.45rem;
		font-size: var(--sl-text-xs);
		line-height: 1.3;
		color: var(--sl-color-gray-2);
	}
	.sb-flow-steps svg {
		flex: none;
		width: 0.9rem;
		height: 0.9rem;
		fill: none;
		stroke: var(--sl-color-text-accent);
		stroke-width: 1.8;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.sb-flow-steps li[data-kind='wait'] {
		border-color: var(--sl-color-accent);
		background: var(--sl-color-accent-low);
		color: var(--sl-color-white);
		font-weight: 600;
	}
	.sb-flow-steps li[data-kind='wait'] svg {
		stroke-width: 2.4;
	}
	.sb-flow-steps li[data-kind='next'] {
		border-style: dashed;
		padding-inline-start: calc(0.6rem + 1.4rem);
	}
	.sb-flow-steps li[data-kind='done'] span,
	.sb-flow-steps li[data-kind='next'] span {
		color: var(--sl-color-gray-2);
	}
	.sb-flow-get {
		flex: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.4rem;
		padding: 0.6rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.75rem;
		background: var(--sl-color-bg);
	}
	.sb-flow-get :global(svg) {
		width: 100%;
		max-width: 11rem;
		height: auto;
	}
	.sb-flow-get p {
		margin: 0;
		font-size: var(--sl-text-xs);
		font-weight: 600;
		color: var(--sl-color-white);
	}
	.sb-flow-get :global(.ink) { stroke: var(--sl-color-gray-2); }
	.sb-flow-get :global(.mut) { stroke: var(--sl-color-gray-3); }
	.sb-flow-get :global(.ln) { stroke: var(--sl-color-gray-5); }
	.sb-flow-get :global(.ac) { stroke: var(--sl-color-accent); }
	.sb-flow-get :global(.fac) { fill: var(--sl-color-accent); }
	.sb-flow-get :global(svg) { --sb-flow-bg: var(--sl-color-bg); }
</style>
