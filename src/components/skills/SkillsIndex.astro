---
/**
 * Every skill, grouped by product, with a filter box. Data: public/skills/downloads/skills.json.
 * Without JavaScript the full list shows; the filter only hides rows.
 */
import { DOWNLOADS, SKILLS_BASE, productsForGroup, skillsByProduct } from '../../lib/skills.mjs';
import { isStaffOnlyHref } from '../../lib/staff-only.mjs';
import site from '../../../site.json';
import ProductBadge from '../ProductBadge.astro';

// Staff-only skills (site.json `staffOnly`) carry data-staff-only: worker.js removes them, and a
// section left with none, from the page everyone else gets. The count is recomputed from what is
// left in the page, so a customer never sees a number that includes them.
const staff = (id: string) => isStaffOnlyHref(`${SKILLS_BASE}/${id}`, site);
const groups = skillsByProduct().map((g) => ({ ...g, staffOnly: g.skills.every((s) => staff(s.id)) }));
const total = groups.reduce((n, g) => n + g.skills.filter((s) => !staff(s.id)).length, 0);
---

<div class="sb-skills-index not-content">
	<label class="sb-skills-filter">
		<span>Filter skills</span>
		<input type="search" placeholder="Try “agenda”, “Reviewers” or “credits”" autocomplete="off" />
	</label>
	<p class="sb-skills-count" role="status" aria-live="polite">{total} skills</p>
	{
		groups.map((g) => (
			<section class="sb-skills-group" data-group data-skills-for={productsForGroup(g.key).join(' ')} data-staff-only={g.staffOnly ? '' : undefined}>
				<h2 id={`skills-${g.key}`}>
					<ProductBadge product={g.badge as 'platform'} size="md" />
					{g.label}
				</h2>
				<ul>
					{g.skills.map((s) => (
						<li
							data-text={`${s.title} ${s.summary} ${s.prompts.join(' ')} ${g.label}`.toLowerCase()}
							data-staff-only={staff(s.id) ? '' : undefined}
							title={staff(s.id) ? 'Visible to Sessionboard staff only' : undefined}
						>
							<a href={`${SKILLS_BASE}/${s.id}`}>{s.title}</a>
							<p>{s.summary}</p>
						</li>
					))}
				</ul>
			</section>
		))
	}
	<p class="sb-skills-all">
		Want them all? <a href={`${DOWNLOADS}/sessionboard-skills.zip`} download>Download every skill (.zip)</a>, or see <a href={`${SKILLS_BASE}/install`}>Install skills</a> for the Claude Code plugin.
	</p>
</div>

<script>
	const root = document.querySelector('.sb-skills-index');
	const input = root?.querySelector<HTMLInputElement>('input[type=search]');
	const count = root?.querySelector('.sb-skills-count');
	const say = (n: number) => {
		if (count) count.textContent = n === 1 ? '1 skill' : `${n} skills`;
	};
	// Staff see the staff-only skills too; count what this reader's page actually holds.
	// A product view ("Skills for ▾", <html data-sb-skills>) hides other products' sections with CSS.
	const inView = (el: Element) => getComputedStyle(el.closest('[data-group]')!).display !== 'none';
	say([...(root?.querySelectorAll('li[data-text]') ?? [])].filter(inView).length);
	input?.addEventListener('input', () => {
		const q = input.value.trim().toLowerCase();
		let shown = 0;
		root!.querySelectorAll<HTMLElement>('[data-group]').forEach((group) => {
			let inGroup = 0;
			group.querySelectorAll<HTMLElement>('li[data-text]').forEach((li) => {
				const hit = !q || (li.dataset.text ?? '').includes(q);
				li.hidden = !hit;
				if (hit) inGroup++;
			});
			group.hidden = inGroup === 0;
			if (inView(group)) shown += inGroup;
		});
		say(shown);
	});
</script>

<style>
	.sb-skills-filter {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		font-weight: 600;
		font-size: var(--sl-text-sm);
		max-width: 28rem;
	}
	.sb-skills-filter input {
		min-height: 2.75rem;
		padding: 0.5rem 0.75rem;
		border: 1px solid var(--sl-color-gray-4);
		border-radius: 0.5rem;
		background: var(--sl-color-bg);
		color: var(--sl-color-text);
		font: inherit;
		font-weight: 400;
	}
	.sb-skills-filter input:focus-visible {
		outline: 2px solid var(--sl-color-text-accent);
		outline-offset: 2px;
	}
	.sb-skills-count {
		margin: 0.5rem 0 0;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.sb-skills-group h2 {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		font-size: var(--sl-text-h4);
		margin: 1.75rem 0 0.5rem;
	}
	.sb-skills-group ul {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 0.5rem;
	}
	.sb-skills-group li {
		position: relative;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		padding: 0.75rem 1rem;
		transition: border-color 0.15s ease, background-color 0.15s ease;
	}
	/* `not-content` opts out of Starlight's link colours, so set the brand accent here
	   (visited included: browser purple is off-brand). The link's ::before covers the
	   card, so the whole card is the target. */
	.sb-skills-group li a,
	.sb-skills-group li a:visited {
		font-weight: 600;
		color: var(--sl-color-text-accent);
		text-decoration: none;
	}
	.sb-skills-group li a::before {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: inherit;
	}
	.sb-skills-group li:hover {
		border-color: var(--sl-color-accent);
		background: var(--sl-color-accent-low);
	}
	.sb-skills-group li:hover a {
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}
	.sb-skills-group li a:focus-visible {
		outline: none;
	}
	.sb-skills-group li:has(a:focus-visible) {
		outline: 2px solid var(--sl-color-text-accent);
		outline-offset: 2px;
	}
	@media (prefers-reduced-motion: reduce) {
		.sb-skills-group li {
			transition: none;
		}
	}
	.sb-skills-group li p {
		margin: 0.25rem 0 0;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	/* Staff see these; worker.js strips them for everyone else. Same lock as the sidebar's. */
	[data-staff-only] > h2::after,
	:not([data-staff-only]) li[data-staff-only] > a::after {
		content: '';
		display: inline-block;
		width: 0.8em;
		height: 0.8em;
		margin-inline-start: 0.4em;
		background-color: currentColor;
		-webkit-mask: var(--sb-lock) no-repeat center / contain;
		mask: var(--sb-lock) no-repeat center / contain;
		opacity: 0.65;
	}
	.sb-skills-all {
		margin-top: 1.5rem;
	}
</style>
